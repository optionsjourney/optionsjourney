# OptionsJourney settings
# Copy this file to .env and fill it in. Never commit .env.
# Most people never edit this: the setup wizard handles broker connections.

# Where broker credentials come from:
#   local   - your own broker logins, stored securely on this computer (default)
#   gateway - development only: borrow access tokens from the author's Tracker2
#             server on the home network. Trading is always blocked in this mode.
#   demo    - a pretend broker and made-up prices, no network at all. Run it with
#             `python -m optionsjourney.demo`, which sets this for you.
BROKER_CREDENTIALS=local

# Gateway mode only
GATEWAY_URL=
GATEWAY_SECRET=

# Port for the web server. Default 2026.
PORT=

# yes = other devices on your home network (phone, laptop) can open the app at
# http://<this computer's address>:<PORT>. There is no login, so anyone on the
# same Wi-Fi could then see and use it. Default: no (this computer only).
LISTEN_ON_NETWORK=

# Where the database lives. Default: your user data folder
# (Mac: ~/Library/Application Support/OptionsJourney).
OPTIONSJOURNEY_DATA_DIR=

